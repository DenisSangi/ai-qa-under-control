{
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPath": "/payments",
    "bodyPatterns": [
      { "matchesJsonPath": "$[?(@.amount > 10000)]" }
    ]
  },
  "response": {
    "status": 402,
    "headers": { "Content-Type": "application/json" },
    "jsonBody": {
      "status": "DECLINED",
      "transactionId": null,
      "reason": "LIMIT_EXCEEDED"
    }
  }
}
